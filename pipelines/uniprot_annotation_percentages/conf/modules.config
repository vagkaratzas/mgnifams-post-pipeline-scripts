/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module configuration: publishing and tool arguments
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { params.outdir },
        mode: 'copy'
    ]

    // Pfam: curated per-model gathering thresholds. Bit-score based, so chunk-safe and
    // independent of -Z / effective_db_size.
    withName: HMMSEARCH_PFAM {
        ext.prefix = { "${meta.id}_pfam" }
        ext.args   = "--noali --cut_ga"
        publishDir = [ path: { params.outdir }, mode: "copy", enabled: false ]
    }

    // Mgnifams: no GA lines in the library, so E-value cutoffs. -Z/--domZ pin the global
    // effective DB size across chunks (omitted when effective_db_size == 0).
    withName: HMMSEARCH_MGNIFAMS {
        ext.prefix = { "${meta.id}_mgnifams" }
        // Closure so params (effective_db_size, evalue_cutoff) resolve at runtime, after any
        // profile override — a plain expression here captures the base default at config-load.
        ext.args   = {
            [
                "--noali",
                (params.effective_db_size ? "-Z ${params.effective_db_size} --domZ ${params.effective_db_size}" : ""),
                "-E ${params.evalue_cutoff}",
                "--domE ${params.evalue_cutoff}"
            ].findAll { it }.join(' ').trim()
        }
        publishDir = [ path: { params.outdir }, mode: "copy", enabled: false ]
    }
}
