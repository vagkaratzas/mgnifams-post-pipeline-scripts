/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running local tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Small subsets: 100 SwissProt sequences vs 14 Pfam + 108 Mgnifams models (~3.5 MB, git-pushable).

    Usage:
        export NXF_SINGULARITY_CACHEDIR="/home/vangelis/Desktop/Tools/singularity"
        nextflow run main.nf -profile test,singularity
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [ cpus: 4, memory: '15.GB', time: '1.h' ]
}

params {
    input_fasta             = "${projectDir}/assets/test_data/uniprot_sprot_100.fasta.gz"
    pfam_hmm                = "${projectDir}/assets/test_data/pfam_100.hmm.gz"
    mgnifams_hmm            = "${projectDir}/assets/test_data/mgnifams_100.hmm.lib.gz"
    evalue_cutoff           = 0.001
    effective_db_size       = 100
    fasta_records_per_chunk = 40    // -> 3 chunks

    outdir = "${projectDir}/tmp"
}

process {
    withName: 'HMMSEARCH_.*' { cpus = 4; memory = '5.0 GB'; time = '1h' }
}
