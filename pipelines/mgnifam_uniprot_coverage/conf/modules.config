/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module configuration: publishing and tool arguments
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { params.outdir },
        mode: 'copy'
    ]

    // The per-target files are the bulk of the output (hundreds of MB at UniProt
    // scale) and exist only to be the mask for the exclusive pass. Keep the
    // per-chunk summaries and family lists, which reduce consumes and a human
    // may want to re-reduce, and drop the rest.
    withName: 'MAP_.*' {
        publishDir = [
            path   : { "${params.outdir}/chunks/${meta.id}/${meta.coords}/${meta.pass}" },
            mode   : 'copy',
            pattern: "out/*.{summary.tsv,families.tsv.gz}",
            saveAs : { fn -> fn.tokenize('/').last() }
        ]
    }

    // Pfam passes use gathering thresholds (bit scores), so only the MGnifams passes rescale.
    withName: 'MAP_TOTAL|MAP_EXCLUSIVE' {
        ext.args = { meta.evalue_scale != null ? "--evalue-scale ${meta.evalue_scale} --max-evalue ${params.max_evalue}" : '' }
    }

    withName: COVERAGE_REDUCE {
        publishDir = [ path: { "${params.outdir}/tables" }, mode: 'copy' ]
    }

    // The emitted directory is already called 'lists', so publish at the root
    // rather than nesting it inside another 'lists'.
    withName: BUILD_CATEGORY_LISTS {
        publishDir = [ path: { params.outdir }, mode: 'copy' ]
    }

    withName: COVERAGE_REPORT {
        publishDir = [ path: { "${params.outdir}/report" }, mode: 'copy' ]
    }

    withName: COVERAGE_FIGURES {
        publishDir = [ path: { "${params.outdir}/figures" }, mode: 'copy' ]
    }

    withName: VALIDATE_COVERAGE {
        publishDir = [ path: { "${params.outdir}/report" }, mode: 'copy' ]
    }
}
