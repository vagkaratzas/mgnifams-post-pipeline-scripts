/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running local tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Real hmmsearch output over 100 SwissProt sequences split into three chunks with
    disjoint targets: one plays SwissProt, two play TrEMBL, so the chunk pairing and
    the pooled UniProtKB view are both exercised.

    Usage:
        export NXF_SINGULARITY_CACHEDIR="/home/vangelis/Desktop/Tools/singularity"
        nextflow run main.nf -profile test,singularity
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [ cpus: 4, memory: '15.GB', time: '1.h' ]
}

params {
    input        = "${projectDir}/assets/test_data/samplesheet.csv"
    lists_dir    = "${projectDir}/assets/test_data/lists"
    mgnifams_hmm = "${projectDir}/assets/test_data/mgnifams_100.hmm.lib.gz"
    coords       = ['ali', 'env']

    outdir = "${projectDir}/tmp"
}
