/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module configuration: publishing and tool arguments
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { params.outdir },
        mode: 'copy'
    ]

    // Models stay in the work dir; publish them so they can be fed back in via
    // --fungtion_models / --caalm_models on later runs
    withName: FUNGTION_DOWNLOADMODELS {
        publishDir = [
            path: { "${params.outdir}/models/fungtion" },
            mode: 'copy'
        ]
    }

    withName: CAALM_DOWNLOADMODELS {
        publishDir = [
            path: { "${params.outdir}/models/caalm" },
            mode: 'copy'
        ]
    }

    withName: FUNGTION_FUNGTION {
        ext.args   = params.fungtion_args
        publishDir = [
            path: { "${params.outdir}/fungtion" },
            mode: 'copy'
        ]
    }

    withName: CAALM_CAALM {
        ext.args   = params.caalm_args
        publishDir = [
            path: { "${params.outdir}/caalm" },
            mode: 'copy'
        ]
    }
}
